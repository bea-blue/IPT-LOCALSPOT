# Copy this file to .env and edit it. .env is private and is NOT committed to Git.

APP_NAME=LocalSpot
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
# Leave empty for: php -S localhost:8000 -t public router.php
# Apache sub-folder example: /localspot/public
APP_BASE_PATH=

# XAMPP MySQL/MariaDB defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=localspot
DB_USERNAME=root
DB_PASSWORD=

# Angeles City area reference point used for weather (not venue coordinates)
WEATHER_LATITUDE=15.1450
WEATHER_LONGITUDE=120.5887
WEATHER_AREA_LABEL="Angeles City area weather"

# Optional: CA bundle for HTTPS if php.ini has no curl.cainfo
CURL_CA_BUNDLE=
